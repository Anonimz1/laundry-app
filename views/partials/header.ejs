<%
  const menuUtama = [
    { key: 'dashboard', href: '/',          label: 'Dashboard' },
    { key: 'pesanan',   href: '/pesanan',   label: 'Pesanan',   badge: locals.aktif },
    { key: 'pelanggan', href: '/pelanggan', label: 'Pelanggan' },
    { key: 'layanan',   href: '/layanan',   label: 'Layanan' },
    { key: 'produk',    href: '/produk',    label: 'Produk' },
  ];
  const menuLain = [
    { key: 'pembayaran', href: '/pembayaran', label: 'Pembayaran' },
    { key: 'laporan',    href: '/laporan',    label: 'Laporan' },
  ];
  const aktifKey = locals.active || 'dashboard';
%><!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Sistem Laundry</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('icons') %>
<div class="frame">
  <aside class="side">
    <div class="brand">
      <div class="brand-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="brand-ic">
          <rect x="3" y="2" width="18" height="20" rx="3"></rect>
          <circle cx="12" cy="13" r="5"></circle>
          <path d="M12 10a3 3 0 0 1 3 3"></path>
          <circle cx="7" cy="6" r="1" fill="currentColor"></circle>
          <line x1="11" y1="6" x2="17" y2="6"></line>
        </svg>
      </div>
      <div>
        <div class="brand-title">Sistem Laundry</div>
        <small class="brand-sub">Operasional & Kasir</small>
      </div>
    </div>

    <div class="me">
      <div class="face">AL</div>
      <div class="me-info">
        <b>Admin Laundry</b>
        <small><span class="online-dot"></span>Online · Owner</small>
      </div>
    </div>

    <h6>MENU UTAMA</h6>
    <nav class="nav">
      <% menuUtama.forEach(m => { %>
        <a href="<%= m.href %>" class="<%= aktifKey === m.key ? 'on' : '' %>">
          <svg class="ic"><use href="#i-<%= m.key %>"/></svg>
          <span><%= m.label %></span>
          <% if (m.badge) { %><span class="badge"><%= m.badge %></span><% } %>
        </a>
      <% }) %>
    </nav>

    <h6>ANALITIK & KEUANGAN</h6>
    <nav class="nav">
      <% menuLain.forEach(m => { %>
        <a href="<%= m.href %>" class="<%= aktifKey === m.key ? 'on' : '' %>">
          <svg class="ic"><use href="#i-<%= m.key %>"/></svg>
          <span><%= m.label %></span>
        </a>
      <% }) %>
    </nav>
  </aside>
  <main class="main">
