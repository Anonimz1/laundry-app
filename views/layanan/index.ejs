<%- include('../partials/header', { title: 'Layanan' }) %>

<div class="top">
  <div>
    <h1>Layanan</h1>
    <p class="sub"><%= rows.length %> layanan tersedia</p>
  </div>
  <div class="actions">
    <a class="pill-btn" href="/layanan/tambah"><svg class="ic"><use href="#i-tambah"/></svg>Tambah Layanan</a>
  </div>
</div>

<% if (error) { %>
  <div class="alert bad"><%= error %></div>
<% } %>

<% if (success) { %>
  <div class="alert"><%= success %></div>
<% } %>

<table class="table">
  <thead>
    <tr>
      <th>Nama Layanan</th>
      <th>Kategori</th>
      <th>Harga</th>
      <th>Satuan</th>
      <th>Estimasi</th>
      <th style="text-align:right">Aksi</th>
    </tr>
  </thead>
  <tbody>
    <% if (rows.length === 0) { %>
      <tr>
        <td colspan="6" style="text-align: center;"><p class="empty">Belum ada data layanan</p></td>
      </tr>
    <% } else { %>
      <% rows.forEach(row => { %>
        <tr>
          <td>
            <div class="nm">
              <div class="av soft"><svg class="ic"><use href="#i-layanan"/></svg></div>
              <b><%= row.nama_layanan %></b>
            </div>
          </td>
          <td><%= row.nama_kategori %></td>
          <td><b>Rp <%= Number(row.harga).toLocaleString('id-ID') %></b></td>
          <td><%= row.satuan %></td>
          <td><%= row.estimasi_hari %> hari</td>
          <td style="text-align:right">
            <a href="/layanan/<%= row.id_layanan %>/edit" class="btn-link">Edit</a>
            <form method="POST" action="/layanan/<%= row.id_layanan %>/hapus" style="display: inline;" onsubmit="return confirm('Yakin ingin menghapus layanan ini?')">
              <button type="submit" class="link-danger">Hapus</button>
            </form>
          </td>
        </tr>
      <% }); %>
    <% } %>
  </tbody>
</table>

<%- include('../partials/footer') %>
